{
  "name": "@bive/app",
  "version": "0.0.0",
  "private": true,
  "description": "화면 앱 (Electron main · preload · renderer)",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "start": "pnpm --filter @bive/app... run build && tsx src/start.ts",
    "cli": "node --conditions=@bive/source --import tsx src/cli.ts",
    "smoke": "pnpm --filter @bive/app... run build && tsx smoke/run-smoke.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bive/shared": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
