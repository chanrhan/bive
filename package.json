{
  "name": "bive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "smoke": "pnpm --filter @bive/app smoke",
    "e2e": "pnpm --filter @bive/app e2e",
    "e2e:pipeline": "pnpm --filter @bive/orchestrator e2e:pipeline",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ],
    "overrides": {
      "@stoplight/prism-cli@5.14.2>@stoplight/prism-core": "5.8.0",
      "@stoplight/prism-cli@5.14.2>@stoplight/prism-http": "5.12.0",
      "@stoplight/prism-cli@5.14.2>@stoplight/prism-http-server": "5.12.2",
      "@stoplight/prism-http-server@5.12.2>@stoplight/prism-core": "5.8.0",
      "@stoplight/prism-http-server@5.12.2>@stoplight/prism-http": "5.12.0",
      "@stoplight/prism-http@5.12.0>@stoplight/prism-core": "5.8.0",
      "@asyncapi/parser@3.6.3>@stoplight/spectral-core": "1.23.0",
      "@asyncapi/parser@3.6.3>@stoplight/spectral-functions": "1.10.3",
      "@stoplight/spectral-functions@1.10.3>@stoplight/spectral-formats": "1.8.3"
    },
    "packageExtensions": {
      "dependency-cruiser@18.7.2": {
        "dependencies": {
          "typescript": "6.0.3"
        }
      }
    },
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current"
      ],
      "libc": [
        "current"
      ]
    }
  }
}
